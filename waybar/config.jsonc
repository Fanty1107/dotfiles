//-*- mode: jsonc -*-
[
{
    "output": "HDMI-A-1",
    "layer": "top", 
    "position": "top", 
    "height": 20, 
    "spacing": 4, 

    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces",
        "custom/sep",
        "mpris"
    ],
    "modules-center": [
    ],

    "modules-right": [
        "custom/cpucat",
        "custom/sep",
        "wireplumber",
        "custom/sep",
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "disk",
        "custom/sep",
        "clock",
        "custom/sep",
        "tray"
    ],

    // Modules configuration
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "warp-on-scroll": false,
        "format": "{icon}",
        "format-icons":{
        "1": "一",
        "2": "二",
        "3": "三",
        "4": "四",
        "5": "五"
        },
        "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": [],
        "5": []
        }
    },
    "custom/cpucat": {
        "exec":"~/.config/waybar/scripts/catloop.sh"
  },
    "hyprland/window" : {
        "max-length": 4,
        "seperate-outputs": false
    },
    "mpris": {
        "format": " {artist} - {title}",
        "format-paused": "󰐊 {artist} - {title}",
        "max-length": 45,
        "tooltip": true,
        "player": "spotify"
    },
    "wireplumber": {
        "format": "Vol: {volume}%",
        "format-muted": "Muted",
        "on-click": "pavucontrol"
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "CPU: {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "Ram: {used}GiB"
    },
    "disk": {
        "interval": 1,
        "path": "/",
        "format": "Disk: {free}"
    },
    "network": {
        "format": "Connected",
        "format-disconnected": "Disconnected ⚠"
    },
    "custom/sep": {
        "format" : "|",
        "interval" : 0
    }
},
{
"output": "DVI-D-1",
    "position": "top",
    "layer": "top",
    "height": 20,
    "spacing": 4, 
    "group/left2": {
      "orientation": "inherit",
      "modules": [
        "hyprland/workspaces"
      ]
    },
    "modules-left": [
      "group/left2"
    ],
    "modules-right": [
      "clock"
    ],
    "hyprland/workspaces": {
      "all-outputs": false,
      "on-click": "activate",
      "format": "{icon}",
      "format-icons": {
        "6": "六",
        "7": "七",
        "8": "八",
        "9": "九"
      },
      "persistent-workspaces": {
        "6": [],
        "7": [],
        "8": [],
        "9": []
      }
    }
}
]
