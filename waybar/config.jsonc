[
  {
    "output": "HDMI-A-1",
    "reload_style_on_change": true,
    "position": "top",
    "mod": "dock",
    "margin-top": 0,
    "height": 38,
    "margin-left": 5,
    "margin-right": 5,
    "margin-bottom": 0,
    "group/left1": {
      "orientation": "inherit",
      "modules": [
        "custom/launcher",
        "idle_inhibitor",
        "custom/updates"
      ]
    },
    "group/left2": {
      "orientation": "inherit",
      "modules": [
        "hyprland/workspaces"
      ]
    },
    "group/left3": {
      "orientation": "inherit",
      "modules": [
        "hyprland/window"
      ]
    },
    "modules-left": [
      "group/left1",
      "group/left2",
      "group/left3"
    ],
    "modules-center": [
      "mpris"
    ],
    "modules-right": [
      "tray",
      "pulseaudio#output",
      "pulseaudio#input",
      "power-profiles-daemon",
      "network",
      "memory",
      "cpu",
      "custom/weather",
      "clock"
    ],
    "hyprland/workspaces": {
      "on-click": "activate",
      "format": "{icon}",
      "format-icons": {
        "1": "一",
        "2": "二",
        "3": "三",
        "4": "四",
        "5": "五"
      },
      "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": [],
        "5": []
      }
    },
    "custom/launcher": {
      "format": " ",
      "on-click": "wofi --show drun",
      "on-click-right": "kitty",
      "tooltip-format": "Menu de aplicativos\n\nClique: abrir launcher\nClique direito: abrir terminal"
    },
    "custom/updates": {
      "format": "{} 󰏖",
      "exec": "checkupdates 2>/dev/null | wc -l",
      "exec-if": "which checkupdates",
      "interval": 3600,
      "on-click": "kitty -e sudo pacman -Syu",
      "tooltip": false
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "󰛊",
        "deactivated": "󰾫"
      }
    },
    "hyprland/window": {
      "format": "{class}",
      "max-length": 55,
      "rewrite": {
        " - ": "", // if no window is focused, a single dash is displayed, this removes it
        "(.*?) - Chromium - chromium": "   $1 ",
        "(.*chrome)...(.*)": "   $1 ",
        "(.*) - Obsidian - .* - obsidian": "   $1 ",
        "(.*nvim)...(.*)": " $2 ",
        "(.*code) - (.*)": " 󰨞  $1 ",
        "^.*btop( .*|$)": " 󰧨 BTOP $1 ",
        "^.*cmatrix( .*|$)": " 󰘨 MATRIX $1 ",
        "(.*) - Spotify": " $1 ",
        "(.*) - com.mitchellh.ghostty": " 󰊠 $1 ",
        "(.*) - Kitty": "  $1 ",
        "(.*) - Alacritty": "   $1 ",
        "(.*) - BeeperTexts": " 󰻞  $1 ",
        "(.*Discord)...(.*).. (.*)": "  $2 ",
        "(.*) - org.gnome.Nautilus": " 󰣆  $1 ",
        "(.*) - fish": "   [$1] ",
        "(.*Steam)...(.*)": "󰓓 $1",
        "(.*imv)...(.*).. (.*)": "   $2",
        "(.*) - com.obsproject.Studio": "  $1 "
      }
    },
    "cpu": {
      "interval": 2,
      "format": "{usage}% 󰍛",
      "on-click": "kitty -e btop"
    },
    "memory": {
      "interval": 2,
      "format": " {percentage}%  ",
      "on-click": "kitty -e btop"
    },
    "clock": {
      "format": " {:%H:%M %a}",
      "format-alt": " {:%d/%m/%Y  %H:%M}",
      "tooltip-format": "<span>{calendar}</span>",
      "calendar": {
        "mode": "month",
        "weeks-pos": "right",
        "mode-mon-col": 3,
        "on-click-right": "mode",
        "format": {
          "month": "<span color='#ffead3'><b>{}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b>{}</b></span>"
        }
      }
    },
    "network": {
      "format-icons": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "format": "{icon}",
      "format-wifi": "{icon}",
      "format-ethernet": "󰀂",
      "format-disconnected": "󰖪",
      "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
      "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
      "tooltip-format-disconnected": "Disconnected",
      "interval": 3,
      "nospacing": 1,
      "on-click": "nm-connection-editor"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "󱤃 ",
        "performance": " ",
        "balanced": "󰗑 ",
        "power-saver": "󰤄"
      }
    },
    "custom/weather": {
      "format": "{}°",
      "tooltip": true,
      "interval": 1800,
      "exec": "wttrbar --nerd --location Curitiba",
      "return-type": "json"
    },
    "pulseaudio#input": {
      "format-source": "",
      "format-source-muted": " ",
      "format": "{format_source}",
      "tooltip-format": "{format_source} {source_volume}%",
      "scroll-step": 1,
      "smooth-scrolling-threshold": 1,
      "max-volume": 100,
      "on-click": "pavucontrol",
      "on-click-right": "pamixer -t",
      "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +1%",
      "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -1%"
    },
    "pulseaudio#output": {
      "format": "{icon}",
      "tooltip-format": "{icon}  {volume}%",
      "format-muted": " off",
      "format-icons": {
        "default": [
          ""
        ]
      },
      "max-volume": 100,
      "scroll-step": 2,
      "smooth-scrolling-threshold": 1,
      "on-click": "pavucontrol",
      "on-click-right": "pamixer -t"
    },
    "tray": {
      "icon-size": 12,
      "spacing": 12
    },
    "mpris": {
      "format": "{player_icon} {dynamic}",
      "format-paused": "<span color='grey'>{status_icon} {dynamic}</span>",
      "max-length": 50,
      "interval": 1,
      "player-icons": {
        "default": "⏸",
        "mpv": "🎵"
      },
      "status-icons": {
        "paused": "▶"
      },
      "ignored-players": [
        "chromium",
        "brave"
      ]
    }
  },
  {
    "output": "DVI-D-1",
    "reload_style_on_change": true,
    "position": "top",
    "mod": "dock",
    "height": 34,
    "margin-left": 5,
    "margin-right": 5,
    "group/left2": {
      "orientation": "inherit",
      "modules": [
        "hyprland/workspaces"
      ]
    },
    "modules-left": [
      "group/left2"
    ],
    "modules-center": [
      "hyprland/window"
    ],
    "modules-right": [
      "clock"
    ],
    "hyprland/workspaces": {
      "all-outputs": false,
      "on-click": "activate",
      "format": "{icon}",
      "format-icons": {
        "6": "六",
        "7": "七",
        "8": "八",
        "9": "九"
      },
      "persistent-workspaces": {
        "6": [],
        "7": [],
        "8": [],
        "9": []
      }
    }
  }
]
